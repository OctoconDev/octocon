# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Docker volumes
/pgdata
/msg_pgdata
/csharp/dev/scylla/data

# Ignore package tarball (built via "mix hex.build").
octocon-*.tar

# docker-compose.dev.yml
basic.conf

# Dev config (contains secrets)
/config/dev.exs

# C# / .NET
csharp/**/bin/
csharp/**/obj/
csharp/**/*.user
csharp/**/*.suo
csharp/**/*.vs/
.vs/
*.ncrunch*
TestResults/
[Pp]ublish/
*.nuget.props
*.nuget.targets

csharp/Interfold.Api/wwwroot/avatars/**
csharp/Interfold.Api/http-messages/**
scripts/certs/**
scripts/keys/**

# Launch settings (contains OAuth secrets, credentials)
csharp/**/Properties/launchSettings.json
artifacts/lifecycle-probe.ndjson

# Internal docs (roadmap, active/archive workstreams) — not for public git yet.
# docs/configuration.md is the only tracked doc (operator/maintainer reference).
docs/*
!docs/configuration.md
docs/active/
docs/archive/

# Cursor planning artifacts — local-only.
/.cursor/plans/

# Copilot chat instruction files — internal, keep local.
/.github/instructions/

