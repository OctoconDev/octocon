<Project Sdk="Aspire.AppHost.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>9f2459e8-120e-4c06-8ae5-392685a34c40</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\hosts\Interfold.Api.Host\Interfold.Api.Host.csproj" />
    <!-- Direct (non-resource) reference so the resource graph can share the env-key /
         service-name / region constants with Contracts instead of duplicating literals.
         IsAspireProjectResource=false keeps Aspire from treating it as a deployable. -->
    <ProjectReference Include="..\..\shared\Interfold.Shared.Contracts\Interfold.Shared.Contracts.csproj" IsAspireProjectResource="false" />
    <!-- Dev-mode seed pipeline (RunMode-only, guarded by IsPublishMode). Brings in Npgsql +
         CassandraCSharpDriver via NpgsqlPostgresExecutor / DataStaxScyllaExecutor so the
         AppHost can run the same in-process seed the tests use. Publish mode keeps this out
         of the emitted graph — the bootstrapper's DatabaseInitPhase owns compose-exec seeding. -->
    <ProjectReference Include="..\..\shared\Interfold.DatabaseBootstrap\Interfold.DatabaseBootstrap.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Docker" />
  </ItemGroup>

</Project>
