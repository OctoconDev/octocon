<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared plumbing consumed by every per-feature Interfold.<Feature>.IntegrationTests and
       by Interfold.Infrastructure.IntegrationTests. Owns BaseEndpointTest, the WebFactoryFixture
       triad, TestServices/, ReplayParityTests, and the Fixtures/*.trace.json corpus. Reaches
       internals of Interfold.Infrastructure / Interfold.Infrastructure.Scylla / Interfold.Shared.Api
       / Interfold.Api.Host via matching InternalsVisibleTo grants in each of those csprojs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\tests.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="TUnit.Aspire" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!-- see the retired Interfold.IntegrationTests.csproj: DbInitHelper drives Postgres +
         Scylla directly, so the drivers must be visible at the test-project level even
         though they are transitively available via Interfold.Infrastructure. -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="CassandraCSharpDriver" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\apis\Interfold.Alters.Api\Interfold.Alters.Api.csproj" />
    <ProjectReference Include="..\..\..\shared\Interfold.Alters.Domain\Interfold.Alters.Domain.csproj" />
    <ProjectReference Include="..\..\..\hosts\Interfold.Api.Host\Interfold.Api.Host.csproj" />
    <ProjectReference Include="..\..\..\apis\Interfold.Auth.Api\Interfold.Auth.Api.csproj" />
    <ProjectReference Include="..\..\..\shared\Interfold.Auth.Domain\Interfold.Auth.Domain.csproj" />
    <ProjectReference Include="..\..\..\apis\Interfold.Friendships.Api\Interfold.Friendships.Api.csproj" />
    <ProjectReference Include="..\..\..\shared\Interfold.Friendships.Domain\Interfold.Friendships.Domain.csproj" />
    <ProjectReference Include="..\..\..\apis\Interfold.Fronting.Api\Interfold.Fronting.Api.csproj" />
    <ProjectReference Include="..\..\..\shared\Interfold.Fronting.Domain\Interfold.Fronting.Domain.csproj" />
    <ProjectReference Include="..\..\..\apis\Interfold.Journals.Api\Interfold.Journals.Api.csproj" />
    <ProjectReference Include="..\..\..\shared\Interfold.Journals.Domain\Interfold.Journals.Domain.csproj" />
    <ProjectReference Include="..\..\..\apis\Interfold.Ops.Api\Interfold.Ops.Api.csproj" />
    <ProjectReference Include="..\..\..\apis\Interfold.Polls.Api\Interfold.Polls.Api.csproj" />
    <ProjectReference Include="..\..\..\shared\Interfold.Polls.Domain\Interfold.Polls.Domain.csproj" />
    <ProjectReference Include="..\..\..\apis\Interfold.Settings.Api\Interfold.Settings.Api.csproj" />
    <ProjectReference Include="..\..\..\shared\Interfold.Settings.Contracts\Interfold.Settings.Contracts.csproj" />
    <ProjectReference Include="..\..\..\shared\Interfold.Settings.Domain\Interfold.Settings.Domain.csproj" />
    <ProjectReference Include="..\..\..\apis\Interfold.Socket.Api\Interfold.Socket.Api.csproj" />
    <ProjectReference Include="..\..\..\apis\Interfold.Systems.Api\Interfold.Systems.Api.csproj" />
    <ProjectReference Include="..\..\..\apis\Interfold.Tags.Api\Interfold.Tags.Api.csproj" />
    <ProjectReference Include="..\..\..\shared\Interfold.Tags.Domain\Interfold.Tags.Domain.csproj" />
    <ProjectReference Include="..\..\..\infrastructure\Interfold.Infrastructure\Interfold.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\hosts\Interfold.AppHost\Interfold.AppHost.csproj">
      <Aliases>AppHost</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\..\..\shared\Interfold.DatabaseBootstrap\Interfold.DatabaseBootstrap.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\*.trace.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
