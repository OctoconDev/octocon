<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Interfold.Contracts\Interfold.Contracts.csproj" />
    <ProjectReference Include="..\Interfold.Settings.Contracts\Interfold.Settings.Contracts.csproj" />
    <ProjectReference Include="..\Interfold.Domain\Interfold.Domain.csproj" />
    <!-- Six peer feature.Domain refs — DeleteAccountCommandHandler injects every peer repo
         interface (IAlterRepository, ITagRepository, IPollRepository, IJournalRepository,
         IFrontingRepository, IFriendshipRepository) plus WipeAlters/WipeTags each pin one of
         them, so the fan-in is unavoidable while the "settings-shape account teardown"
         handlers stay co-located. Each feature.Domain transitively re-exports its own
         feature.Contracts (which carries the events the handlers publish — FriendshipRemovedEvent
         from DeleteAccount, for instance). -->
    <ProjectReference Include="..\Interfold.Alters.Domain\Interfold.Alters.Domain.csproj" />
    <ProjectReference Include="..\Interfold.Tags.Domain\Interfold.Tags.Domain.csproj" />
    <ProjectReference Include="..\Interfold.Polls.Domain\Interfold.Polls.Domain.csproj" />
    <ProjectReference Include="..\Interfold.Journals.Domain\Interfold.Journals.Domain.csproj" />
    <ProjectReference Include="..\Interfold.Friendships.Domain\Interfold.Friendships.Domain.csproj" />
    <ProjectReference Include="..\Interfold.Fronting.Domain\Interfold.Fronting.Domain.csproj" />
    <!-- Auth.Contracts for AuthenticationConfiguration (SetupEncryptionCommandHandler +
         RecoverEncryptionCommandHandler resolve IOptionsMonitor<AuthenticationConfiguration>
         to read the encryption pepper). -->
    <ProjectReference Include="..\Interfold.Auth.Contracts\Interfold.Auth.Contracts.csproj" />
    <!-- Systems.Contracts for PublicSystemReadModel — IAccountRepository.GetPublicSystemAsync
         projects the narrow public-wire subset (used by Interfold.Systems.Api's
         PublicSystemsController). Previously reachable through the spine's dropped
         Interfold.Domain -> Systems.Contracts back-ref; travels with IAccountRepository. -->
    <ProjectReference Include="..\Interfold.Systems.Contracts\Interfold.Systems.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
</Project>
