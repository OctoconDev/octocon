    <ProjectReference Include="..\Interfold.Tags.Contracts\Interfold.Tags.Contracts.csproj" />
    <ProjectReference Include="..\Interfold.Fronting.Contracts\Interfold.Fronting.Contracts.csproj" />
    <ProjectReference Include="..\Interfold.Friendships.Contracts\Interfold.Friendships.Contracts.csproj" />
  </ItemGroup>
</Project>
