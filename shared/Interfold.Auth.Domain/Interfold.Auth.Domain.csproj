<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Interfold.Auth.Contracts\Interfold.Auth.Contracts.csproj" />
    <ProjectReference Include="..\Interfold.Shared.Contracts\Interfold.Shared.Contracts.csproj" />
    <ProjectReference Include="..\Interfold.Domain\Interfold.Domain.csproj" />
    <!-- Feature.Domain -> feature.Domain arrow introduced by Phase-3 Settings slice #8.
         LinkOAuthIdentityCommandHandler + AuthenticateOAuthCommandHandler inject
         IAccountRepository + IEncryptionStateRepository, both of which moved into
         Interfold.Settings.Domain. Persist through Phase 4 barring a dedicated auth-scoped
         account read/write surface. -->
    <ProjectReference Include="..\Interfold.Settings.Domain\Interfold.Settings.Domain.csproj" />
    <!-- Feature.Domain -> feature.Contracts arrow: LinkOAuthIdentityCommandHandler publishes
         Settings{Discord,Google,Apple}AccountLinkedEvent, which moved into
         Interfold.Settings.Contracts.Events during Phase-3 Settings slice #8 (same
         cross-slice-publisher pattern as the Friendships slice's FriendshipRemovedEvent). -->
    <ProjectReference Include="..\Interfold.Settings.Contracts\Interfold.Settings.Contracts.csproj" />
  </ItemGroup>
</Project>
