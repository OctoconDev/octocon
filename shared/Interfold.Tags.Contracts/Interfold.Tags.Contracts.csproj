<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Interfold.Shared.Contracts\Interfold.Shared.Contracts.csproj" />
    <!-- TagSocketPayload / TagDeletedSocketPayload / SocketBatchedTagsPayload implement
         ISocketPayload; back-ref to the socket leaf keeps the marker interface reachable. -->
    <ProjectReference Include="..\Interfold.Socket.Contracts\Interfold.Socket.Contracts.csproj" />
    <!-- First cross-feature Contracts->Contracts reference in the codebase (paired with the
         Fronting.Contracts->Alters.Contracts ref added in the same Post-Alters cleanup slice).
         TagPublicReadModel.Alters binds IReadOnlyList<BareAlter>, which post-cleanup lives in
         Interfold.Alters.Contracts. Alters.Contracts is the "leaf" feature Contracts that peers
         can depend on (symmetric with how it already owns AlterReadModel : BareAlter). -->
    <ProjectReference Include="..\Interfold.Alters.Contracts\Interfold.Alters.Contracts.csproj" />
  </ItemGroup>
</Project>
