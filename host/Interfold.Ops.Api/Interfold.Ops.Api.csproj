<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!-- Mirror the implicit usings Microsoft.NET.Sdk.Web adds. Interfold.Ops.Api is a plain
       Microsoft.NET.Sdk library (no Kestrel), but the moved NodeRoleController + TrustController
       assume the Web-SDK implicits are present. Same shape as the other feature.Api projects
       (Alters / Friendships / Fronting / Journals / Polls / Settings / Systems / Tags). -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Interfold.Api.Shared\Interfold.Api.Shared.csproj" />
    <!-- Facade-shape exception: direct ref to the spine Interfold.Domain because
         NodeRoleController binds INodeRoleContext, which lives on the spine at
         shared/Interfold.Domain/Abstractions/INodeRoleContext.cs (registered by
         AddInterfoldCluster). Systems (#7) has the same exception for a different reason
         (repository-interface access after slice #8 relocations); Ops is the second and,
         per current planning, last facade to invoke this exception. TrustOptions +
         NodeGroup live on Interfold.Shared.Contracts, reachable transitively via Interfold.Domain
         and Interfold.Api.Shared, so no other feature refs are needed. -->
    <ProjectReference Include="..\..\shared\Interfold.Domain\Interfold.Domain.csproj" />
  </ItemGroup>
</Project>
