<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-local NuGet configuration. `<clear/>` drops any package sources
  inherited from user-scoped configs (e.g. the operator's private feeds for
  unrelated projects); only nuget.org is used to restore this solution. Also
  silences NU1507 under Central Package Management (see Directory.Packages.props),
  which requires either a single source or explicit package source mapping.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
