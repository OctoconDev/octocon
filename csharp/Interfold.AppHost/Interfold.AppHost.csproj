<Project Sdk="Aspire.AppHost.Sdk/13.4.2">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>9f2459e8-120e-4c06-8ae5-392685a34c40</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Interfold.Api\Interfold.Api.csproj" />
    <!-- Direct (non-resource) reference so the resource graph can share the env-key /
         service-name / region constants with Contracts instead of duplicating literals.
         IsAspireProjectResource=false keeps Aspire from treating it as a deployable. -->
    <ProjectReference Include="..\Interfold.Contracts\Interfold.Contracts.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Docker" Version="13.4.2" />
  </ItemGroup>

</Project>
